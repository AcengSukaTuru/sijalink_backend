NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CORS_ORIGINS=http://localhost:3000
BUSINESS_TIMEZONE=Asia/Jakarta
WORK_START_TIME=08:00
# Direktori foto privat; gunakan volume persisten di deployment.
PRIVATE_UPLOAD_DIR=private-uploads

# Database lokal (akan dipakai ketika modul persistence mulai dibuat)
DATABASE_URL=postgresql://sijalink:sijalink_dev@localhost:5432/sijalink?schema=public

# Jangan isi credential router di .env yang di-commit. Konfigurasi ini hanya
# untuk development lokal dan tidak dipakai sampai adapter RouterOS aktif.
MIKROTIK_HOST=
MIKROTIK_PORT=8728
MIKROTIK_USERNAME=
MIKROTIK_PASSWORD=
MIKROTIK_TLS=false
MIKROTIK_TIMEOUT_MS=5000
