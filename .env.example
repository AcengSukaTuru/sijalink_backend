NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CORS_ORIGINS=http://localhost:3000
BUSINESS_TIMEZONE=Asia/Jakarta
WORK_START_TIME=08:00
# Storage Driver: local | minio
STORAGE_DRIVER=local

# Direktori foto privat jika STORAGE_DRIVER=local; gunakan volume persisten di deployment.
PRIVATE_UPLOAD_DIR=private-uploads

# MinIO / S3 Object Storage (wajib diisi jika STORAGE_DRIVER=minio)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sijalink-private
MINIO_REGION=us-east-1

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sijalink
DB_USER=sijalink
DB_PASSWORD=sijalink_dev
AUTO_MIGRATE=true

# Prisma 6 wajib memakai connection string ini sebagai datasource URL.
# Nilainya harus sama dengan DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD di atas.
DATABASE_URL=postgresql://sijalink:sijalink_dev@localhost:5432/sijalink?schema=public

# Jangan isi credential router di .env yang di-commit. Konfigurasi ini hanya
# untuk development lokal dan tidak dipakai sampai adapter RouterOS aktif.
MIKROTIK_HOST=
MIKROTIK_PORT=8728
MIKROTIK_USERNAME=
MIKROTIK_PASSWORD=
MIKROTIK_TLS=false
MIKROTIK_TIMEOUT_MS=5000
