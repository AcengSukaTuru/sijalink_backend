NODE_ENV=production
# Port host untuk API. FE akses: http://IP_SERVER:3000/api/v1
HOST_API_PORT=3000
PORT=3000

# Port host; 9000 dipakai Portainer, jadi MinIO expose ke 19000/19001.
MINIO_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001

# PostgreSQL hanya expose lewat interface Tailscale.
TAILSCALE_IP=100.120.0.26
DB_HOST_PORT=15432
JWT_SECRET=isi-dengan-minimal-32-karakter-acak-dan-aman-disini
CORS_ORIGINS=*
BUSINESS_TIMEZONE=Asia/Jakarta
WORK_START_TIME=08:00

# Storage MinIO (hostname di dalam docker compose adalah service 'minio')
STORAGE_DRIVER=minio
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=sijalink_admin
MINIO_SECRET_KEY=sijalink_secret_pass_panjang_123
MINIO_BUCKET=sijalink-private
MINIO_REGION=us-east-1

# PostgreSQL (hostname di dalam docker compose adalah service 'postgres')
DB_HOST=postgres
DB_PORT=5432
DB_NAME=sijalink
DB_USER=sijalink
DB_PASSWORD=sijalink_db_secure_pass
DATABASE_URL=postgresql://sijalink:sijalink_db_secure_pass@postgres:5432/sijalink?schema=public
AUTO_MIGRATE=true

# MikroTik RouterOS (opsional jika sudah terhubung ke router ISP)
MIKROTIK_HOST=
MIKROTIK_PORT=8728
MIKROTIK_USERNAME=
MIKROTIK_PASSWORD=
MIKROTIK_TLS=false
MIKROTIK_TIMEOUT_MS=5000
